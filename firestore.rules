rules_version = '2';

// MULTI-TENANT RULES
//
// This app is sold to many mobile shops. Everything a shop records lives under
// `shops/{shopId}`, and the single most important property of this file is
// that a member of one shop can read nothing belonging to another.
//
// The client is NOT trusted to scope its own queries. `ShopScope` in the Dart
// code makes a cross-shop read hard to write by accident, but these rules are
// what make it impossible — a stolen API key, a modified client or a plain
// bug all stop here.
//
// The membership check is `exists()` on the member document rather than a
// field on the user's profile, because a profile is written by the user and a
// member document is written by a shop admin. Trusting the former would let
// anybody join any shop by editing their own record.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      // Lower-cased because invites are keyed that way: `Ramesh@shop.com` and
      // `ramesh@shop.com` are one person, and a case mismatch would lock
      // somebody out of the shop they were invited to with nothing to explain
      // why.
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function memberPath(shopId) {
      return /databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid);
    }

    function isMember(shopId) {
      return signedIn() && exists(memberPath(shopId));
    }

    // Photos a shop may add in a month: what the app's owner set for it, or
    // 500 (kDefaultPhotosPerMonth in shop_photos.dart).
    function photoLimit(shopId) {
      return exists(/databases/$(database)/documents/limits/$(shopId))
        ? get(/databases/$(database)/documents/limits/$(shopId)).data.photosPerMonth
        : 500;
    }

    function isAdminOf(shopId) {
      return isMember(shopId) && get(memberPath(shopId)).data.role == 'admin';
    }

    function invitePath() {
      return /databases/$(database)/documents/invites/$(myEmail());
    }

    // An invited person joining: the second self-grant (the first is the
    // owner creating their shop). Only for themselves, only into the shop
    // their invite names, only with the role it names, never as owner.
    // Without this the invite could never be claimed: staff signed up and
    // were sent to "create a shop" (found 2026-11-25).
    function claimsInvite(shopId, uid) {
      return signedIn()
        && uid == request.auth.uid
        && myEmail() != ''
        && exists(invitePath())
        && get(invitePath()).data.shopId == shopId
        && request.resource.data.role == get(invitePath()).data.role
        && request.resource.data.get('isOwner', false) != true;
    }

    // ---- the shop, and everything under it -----------------------------

    match /shops/{shopId} {

      // Reading the shop itself is for its own members. There is deliberately
      // no rule permitting a list of the shops collection: one shop must not
      // be able to enumerate the others, which is also why an invited user
      // finds their shop through `invites/{email}` instead of by searching.
      allow get: if isMember(shopId);

      // Created by whoever is signing up, and only with themselves as owner.
      // Without that second condition somebody could create a shop owned by
      // another account and then be unable to administer it — or worse, name
      // somebody else's uid as owner.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if isAdminOf(shopId);

      // No delete. A shop holds the only copy of a business's records, and an
      // accidental or malicious delete is not something the app should be
      // able to do at all.
      allow delete: if false;

      // Members: readable by the shop, written only by its admins.
      match /members/{uid} {
        allow read: if isMember(shopId);

        // The owner writes their own first membership as part of creating the
        // shop, at which point no member document exists yet for isAdminOf to
        // find. That self-grant is the only one allowed, and it is narrow:
        //
        //   - it is for themselves, and
        //   - the shop must name them as its owner once this write lands.
        //
        // `getAfter` rather than `get` because the shop document is written in
        // the SAME batch — `get` would look at the state before the batch and
        // find nothing, so shop creation could never satisfy it.
        //
        // An earlier version of this rule omitted the ownership check, and a
        // rules test caught what that meant: any signed-in person could write
        // themselves into ANY existing shop by setting isOwner, and then read
        // everything in it. Tenant isolation rests on this one condition.
        allow create: if isAdminOf(shopId)
          || (signedIn()
              && uid == request.auth.uid
              && request.resource.data.isOwner == true
              && getAfter(/databases/$(database)/documents/shops/$(shopId))
                   .data.ownerUid == request.auth.uid)
          || claimsInvite(shopId, uid);

        allow update: if isAdminOf(shopId);

        // An admin removes people; anybody may remove THEMSELVES, which is
        // how deleting your own account works (a Google Play requirement).
        // The app refuses it for the last admin of a shop with other people
        // in it — see leaveBlockFor in membership.dart.
        allow delete: if isAdminOf(shopId)
          || (signedIn() && uid == request.auth.uid);
      }

      // The shop's own view of who it has invited.
      match /invites/{email} {
        allow read: if isMember(shopId);
        allow write: if isAdminOf(shopId);
        // The invited person clears the shop's copy once they have joined.
        allow delete: if signedIn() && email == myEmail();
      }

      // Money out. Anyone in the shop writes one down — whoever paid for the
      // tea knows — but only an admin changes or deletes one afterwards, so
      // yesterday's spending cannot quietly shrink.
      match /expenses/{id} {
        allow read, create: if isMember(shopId);
        allow update, delete: if isAdminOf(shopId);
      }

      // EVERYTHING ELSE under a shop — stock, customers, sales, service
      // orders, labels, counters, settings, tasks, enquiries.
      //
      // One rule rather than a block per collection, so a new area added in
      // Dart is protected the day it is written instead of the day somebody
      // remembers to come back here.
      //
      // It must NOT cover members or invites. Firestore ORs every match that
      // applies to a path, so a tighter block above does not override this
      // one — until 2026-11-21 it didn't exclude them, and any staff member
      // could write `members/{theirUid}` with role 'admin', add strangers to
      // the shop, or remove other people. A collection that needs tighter
      // rules must be listed here as well as given its own match.
      match /{collection}/{document=**} {
        allow read: if isMember(shopId);
        allow write: if isMember(shopId)
          && !(collection in ['members', 'invites', 'expenses', 'usage']);
      }

      // PHOTOS USED THIS MONTH (shop_photos.dart, storage.rules).
      //
      // One counter per month that only ever goes up by one, to at most the
      // shop's limit. storage.rules accepts photo number N only once this
      // counter has reached N — so the counter caps what a shop can store,
      // and nobody can reset it, lower it or skip past the limit, whatever
      // app they use.
      match /usage/{month} {
        allow read: if isMember(shopId);
        allow create: if isMember(shopId)
          && request.resource.data.keys().hasOnly(['photos'])
          && request.resource.data.photos == 1
          && 1 <= photoLimit(shopId);
        allow update: if isMember(shopId)
          && request.resource.data.keys().hasOnly(['photos'])
          && request.resource.data.photos == resource.data.photos + 1
          && request.resource.data.photos <= photoLimit(shopId);
        allow delete: if false;
      }
    }

    // WHAT EACH SHOP MAY USE. Set by the app's owner in the Firebase console
    // (`limits/<shopId>` with `photosPerMonth`), never by a shop: a shop's
    // people may read theirs, nobody may write it from an app.
    match /limits/{shopId} {
      allow read: if isMember(shopId);
      allow write: if false;
    }

    // ---- outside any shop ----------------------------------------------

    // Which shop a person belongs to. Read and written by that person alone,
    // plus deleted by an admin removing them — which is why delete is open to
    // a shop admin whose shop the document points at.
    match /users/{uid} {
      allow read, write: if signedIn() && uid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.shopId is string
        && isAdminOf(resource.data.shopId);
    }

    // Pending invites, keyed by email.
    //
    // A signed-in user may read exactly the one addressed to them, and delete
    // it once claimed. They cannot list the collection, so this reveals
    // nothing about who else has been invited anywhere.
    //
    // Writing one is for the admin of the shop the invite names — checked
    // against the incoming data, since the document may not exist yet.
    match /invites/{email} {
      allow get: if signedIn() && email == myEmail();
      allow delete: if signedIn()
        && (email == myEmail()
            || (resource.data.shopId is string
                && isAdminOf(resource.data.shopId)));
      allow create, update: if signedIn()
        && request.resource.data.shopId is string
        && isAdminOf(request.resource.data.shopId);
      allow list: if false;
    }

    // Customer ratings of a finished job (FLOW §10), keyed by an unguessable
    // token. Top-level because the customer who rates has no account: they
    // cannot be a member of anything, so the token in their link is the only
    // key there is.
    //
    // - Anyone may GET one rating by its token. Nobody may list them except a
    //   member of the shop the ratings belong to, and only when the query
    //   asks for that shop's — so a stranger cannot walk the collection, and
    //   one shop cannot read another's.
    // - A member asks: creates the request for their own shop, unanswered,
    //   with exactly the public fields and nothing private.
    // - The customer answers ONCE: only stars, comment and ratedAt may change,
    //   only while unanswered, stars a whole number 1–5, a short comment, and
    //   the time is the server's. The first answer stands.
    // - Only that shop's admin may delete one.
    match /ratings/{token} {
      allow get: if true;
      allow list: if signedIn()
        && resource.data.shopId is string
        && isMember(resource.data.shopId);

      allow create: if request.resource.data.shopId is string
        && isMember(request.resource.data.shopId)
        && request.resource.data.keys().hasOnly([
             'shopId', 'orderId', 'orderNumber', 'shopName', 'device',
             'customerFirstName', 'createdAt', 'stars', 'comment', 'ratedAt'])
        && request.resource.data.stars == null
        && request.resource.data.ratedAt == null;

      allow update: if resource.data.stars == null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['stars', 'comment', 'ratedAt'])
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.ratedAt == request.time;

      allow delete: if resource.data.shopId is string
        && isAdminOf(resource.data.shopId);
    }
  }
}
